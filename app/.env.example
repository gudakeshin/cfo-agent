# Required — validated at startup
ANTHROPIC_API_KEY=sk-ant-...

# Model (Opus for demos; Haiku for cheap rehearsal loops)
ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Database (relative to backend/)
DATABASE_URL=sqlite:///./data/cfo_agent.db

# Email: Resend → SMTP → file outbox fallback
# RESEND_API_KEY=
# EMAIL_FROM=cfo-agent@example.com
# EMAIL_TO=cfo@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Scheduler (IST). Point DIGEST_CRON a few minutes ahead to verify live.
DIGEST_CRON=0 8 * * mon
REDLINE_CRON=*/15 * * * *
TIMEZONE=Asia/Kolkata

# Optional overrides
# FRONTEND_DIST=../frontend/dist

# Data mode: "replay" (demo — a replay clock walks the synthetic quarter) or
# "live" (real feed — digests target the latest week, red-line sweep uses today/latest data)
# DATA_MODE=replay

# LLM guardrails per pipeline run (0 calls = auto: 1 + 2×max_items + 1)
# MAX_LLM_CALLS_PER_RUN=0
# MAX_LLM_COST_USD_PER_RUN=5.0
# LLM_TIMEOUT_S=180
# LLM_MAX_RETRIES=3

# ── Deployment & security (see DEPLOYMENT.md) ────────────────────────────────
# DEMO_MODE=true              # false for a client pilot (needs SECRET_KEY + sign-in)
# SECRET_KEY=                 # ≥32 chars; signs sessions, encrypts connector secrets
# AUTH_MODE=off               # off (demo only) | local | oidc
# LOCAL_USERS_FILE=./config/users.yaml
# OIDC_ISSUER= / OIDC_CLIENT_ID= / OIDC_CLIENT_SECRET= / OIDC_ROLE_MAP={}
# PUBLIC_BASE_URL=http://127.0.0.1:8000
# CORS_ORIGINS=               # comma-separated; empty = same-origin only
# RUN_SCHEDULER=true          # false on API replicas when a worker runs jobs
# PII_MASKING=false           # true: customer/vendor names aliased before AI calls
# CSV_INBOX_DIR=./data/inbox  # file-drop connector root
# LOG_FORMAT=text             # json for log platforms

# ── Model provider (see DEPLOYMENT.md) ───────────────────────────────────────
# LLM_PROVIDER=anthropic      # anthropic | bedrock | vertex
# AWS_REGION= / AWS_PROFILE=  # bedrock
# VERTEX_PROJECT_ID= / VERTEX_REGION=   # vertex
# DATA_RESIDENCY=             # india → refuse non-India processing
# NEWS_PROVIDER=same          # same | anthropic | off
# STRUCTURED_OUTPUT_MODE=auto # auto | native | tool
