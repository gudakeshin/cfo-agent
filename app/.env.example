# Required — validated at startup
ANTHROPIC_API_KEY=sk-ant-...

# Model (Opus for demos; Haiku for cheap rehearsal loops)
ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Database (relative to backend/)
DATABASE_URL=sqlite:///./data/cfo_agent.db

# Email: Resend → SMTP → file outbox fallback
# RESEND_API_KEY=
# EMAIL_FROM=cfo-agent@example.com
# EMAIL_TO=cfo@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Scheduler (IST). Point DIGEST_CRON a few minutes ahead to verify live.
DIGEST_CRON=0 8 * * mon
REDLINE_CRON=*/15 * * * *
TIMEZONE=Asia/Kolkata

# Optional overrides
# FRONTEND_DIST=../frontend/dist
