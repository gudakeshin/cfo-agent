<!DOCTYPE html>
<html>
<head><meta charset="utf-8"/><title>Red-line alert</title></head>
<body style="margin:0;padding:0;background:#1a0505;font-family:Georgia,'Times New Roman',serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="padding:24px 0;">
    <tr><td align="center">
      <table role="presentation" width="600" cellspacing="0" cellpadding="0" style="background:#ffffff;border:3px solid #b00020;">
        <tr><td style="padding:24px 28px;background:#b00020;color:#ffffff;">
          <div style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;">URGENT · RED LINE</div>
          <div style="font-size:22px;font-weight:bold;margin-top:8px;">{{ alert.title }}</div>
        </td></tr>
        <tr><td style="padding:24px 28px;font-size:15px;line-height:1.5;color:#1a1a1a;">
          <p>{{ alert.description }}</p>
          <p style="font-size:13px;color:#5c6b73;">
            Week {{ alert.week }} · as of {{ alert.as_of_date }} · rule {{ alert.rule_id }}
          </p>
          <pre style="background:#f7f9fa;padding:12px;font-size:12px;overflow:auto;">{{ alert.evidence_json }}</pre>
          {% if alert.synthesis_json %}
          <div style="margin-top:16px;padding-top:12px;border-top:1px solid #e8ecf0;">
            <strong>Context</strong>
            <pre style="white-space:pre-wrap;font-size:13px;">{{ alert.synthesis_json }}</pre>
          </div>
          {% endif %}
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
