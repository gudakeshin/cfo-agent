# ── Copy to .env for docker compose and fill in. Never commit the filled file. ──

# Required for LLM_PROVIDER=anthropic (or NEWS_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
POSTGRES_PASSWORD=change-me-long-random
# ≥32 random characters: signs sessions and encrypts stored connector secrets
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Pilot posture
DEMO_MODE=false            # disables synthetic-data endpoints; requires sign-in + SECRET_KEY
DATA_MODE=live             # digests/alerts follow the real calendar and latest data
PII_MASKING=true           # customer/vendor names replaced by aliases before any AI call
PUBLIC_BASE_URL=https://cfo-agent.client.example   # as users reach it (TLS terminated upstream)
TIMEZONE=Asia/Kolkata
DIGEST_CRON=0 8 * * mon
REDLINE_CRON=*/15 * * * *

# Sign-in: "local" (users file, see scripts/manage_users.py) or "oidc" (SSO)
AUTH_MODE=local
# USERS_FILE=./users.yaml
# AUTH_MODE=oidc
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ROLES_CLAIM=groups
# OIDC_ROLE_MAP={"<cfo-group-id>": "cfo", "<delegate-group-id>": "delegate", "<it-admin-group-id>": "admin"}
# OIDC_DEFAULT_ROLE=viewer

# Model provider and residency (see DEPLOYMENT.md → Model provider and data residency)
LLM_PROVIDER=anthropic                # anthropic | bedrock | vertex
# For India-only processing:
# LLM_PROVIDER=bedrock
# AWS_REGION=ap-south-1               # or ap-south-2; credentials from the IAM role
# ANTHROPIC_MODEL=in.anthropic.claude-sonnet-5
# NEWS_MODEL=in.anthropic.claude-sonnet-5
# — or —
# LLM_PROVIDER=vertex
# VERTEX_PROJECT_ID=client-project
# VERTEX_REGION=asia-south1
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/vertex-sa.json
# DATA_RESIDENCY=india                # refuse to start unless every model call stays in India
NEWS_PROVIDER=same                    # same | anthropic (public topics only) | off

# Model and AI guardrails
ANTHROPIC_MODEL=claude-opus-4-8
MAX_LLM_COST_USD_PER_RUN=5.0

# Email (optional; otherwise copies are written to the outbox volume)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=cfo-agent@client.example
# EMAIL_TO=cfo@client.example

# Host binding (default: localhost only, behind the client's reverse proxy)
# API_BIND=127.0.0.1
# API_PORT=8000
# INBOX_DIR=./inbox

# Multi-tenant hosting (optional): YAML of tenants, each with its own database and hosts
# TENANTS_FILE=/config/tenants.yaml
